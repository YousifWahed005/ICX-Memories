# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: your production URL, used for social share previews (Open Graph).
# Set this on Vercel once you know your domain, e.g. https://icx-suez.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
